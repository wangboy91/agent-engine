{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["asset_manifest"],
  "additionalProperties": true,
  "properties": {
    "asset_manifest": {
      "type": "object",
      "required": ["assets"],
      "additionalProperties": true,
      "properties": {
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["asset_id", "type", "source", "status"],
            "additionalProperties": true,
            "properties": {
              "asset_id": {
                "type": "string"
              },
              "shot_id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "duration": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}

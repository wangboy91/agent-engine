{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["review_report"],
  "additionalProperties": true,
  "properties": {
    "review_report": {
      "type": "object",
      "required": ["score", "need_retry", "problems", "strengths", "next_actions"],
      "additionalProperties": true,
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "need_retry": {
          "type": "boolean"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      }
    }
  }
}

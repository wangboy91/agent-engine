{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["render_prompt_pack"],
  "additionalProperties": true,
  "properties": {
    "render_prompt_pack": {
      "type": "object",
      "required": ["prompts"],
      "additionalProperties": true,
      "properties": {
        "prompts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "shot_id",
              "provider",
              "type",
              "prompt",
              "duration",
              "aspect_ratio",
              "resolution"
            ],
            "additionalProperties": true,
            "properties": {
              "shot_id": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "duration": {
                "type": "integer"
              },
              "aspect_ratio": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}

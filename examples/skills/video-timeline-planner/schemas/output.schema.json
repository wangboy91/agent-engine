{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["timeline", "video_draft"],
  "additionalProperties": true,
  "properties": {
    "timeline": {
      "type": "object",
      "required": ["duration_seconds", "tracks"],
      "additionalProperties": true,
      "properties": {
        "duration_seconds": {
          "type": "integer"
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "video_draft": {
      "type": "object",
      "required": ["status", "render_strategy", "deliverables"],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string"
        },
        "render_strategy": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        },
        "deliverables": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          }
        }
      }
    }
  }
}

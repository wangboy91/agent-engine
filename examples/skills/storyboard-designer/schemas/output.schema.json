{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["storyboard"],
  "additionalProperties": true,
  "properties": {
    "storyboard": {
      "type": "object",
      "required": ["shots"],
      "additionalProperties": true,
      "properties": {
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "shot_id",
              "segment_id",
              "duration",
              "visual_type",
              "camera",
              "description",
              "screen_text",
              "asset_needed"
            ],
            "additionalProperties": true,
            "properties": {
              "shot_id": {
                "type": "string"
              },
              "segment_id": {
                "type": "string"
              },
              "duration": {
                "type": "integer"
              },
              "visual_type": {
                "type": "string"
              },
              "camera": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "screen_text": {
                "type": "string"
              },
              "asset_needed": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
